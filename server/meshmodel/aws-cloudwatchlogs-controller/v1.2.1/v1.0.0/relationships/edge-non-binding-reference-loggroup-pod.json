{
  "id": "loggroup-pod-observability",
  "evaluationQuery": "edge_loggroup_pod_logs",
  "kind": "edge",
  "metadata": {
    "description": "CloudWatch LogGroup collects Pod application logs",
    "styles": { "primaryColor": "", "svgColor": "", "svgWhite": "" },
    "isAnnotation": false
  },
  "model": {
    "version": "",
    "name": "aws-cloudwatchlogs-controller",
    "displayName": "",
    "id": "loggroup-pod-id",
    "registrant": { "kind": "github" },
    "model": { "version": "v1.2.1" }
  },
  "schemaVersion": "relationships.meshery.io/v1alpha3",
  "selectors": [
    {
      "allow": {
        "from": [
          {
            "id": null,
            "kind": "LogGroup",
            "match": {},
            "model": {
              "version": "",
              "name": "aws-cloudwatchlogs-controller",
              "id": "aws-cloudwatchlogs-id",
              "registrant": { "kind": "github" }
            },
            "patch": {
              "patchStrategy": "add",
              "mutatorRef": [ ["spec", "logGroupName"] ],
              "value": "/eks/pods/{{ .mutatedRef.namespace }}/{{ .mutatedRef.name }}"
            }
          }
        ],
        "to": [
          {
            "id": null,
            "kind": "Pod",
            "match": {},
            "model": {
              "version": "",
              "name": "kubernetes",
              "id": "kubernetes-pod-id",
              "registrant": { "kind": "github" }
            },
            "patch": {
              "patchStrategy": "replace",
              "mutatedRef": [ ["metadata", "name"], ["metadata", "namespace"] ]
            }
          }
        ]
      },
      "deny": { "from": [], "to": [] }
    }
  ],
  "subType": "reference",
  "status": "enabled",
  "type": "non-binding",
  "version": "v1.0.0"
}
